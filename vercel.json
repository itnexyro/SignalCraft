{
  "version": 2,
  "buildCommand": "echo 'Using committed dist'",
  "installCommand": "echo 'Skipping install'",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/((?!assets|api)[^.]*)", "destination": "/index.html" }
  ]
}
